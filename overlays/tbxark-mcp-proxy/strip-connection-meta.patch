+// connectionMetaKeys are the _meta fields that describe a single 2026-07-28
+// connection. On a request the proxy forwards they describe the caller's
+// connection to the proxy, not the proxy's connection to the downstream: on a
+// downstream connection that uses an older version the caller's protocolVersion
+// would contradict the Mcp-Protocol-Version header, which strict servers reject,
+// and on a 2026-07-28 connection mcp-go sets its own values for only some of
+// them.
+var connectionMetaKeys = []string{
+	mcp.MetaKeyProtocolVersion,
+	mcp.MetaKeyClientInfo,
+	mcp.MetaKeyClientCapabilities,
+	mcp.MetaKeyServerInfo,
+	mcp.MetaKeyLogLevel,
+	mcp.MetaKeySubscriptionID,
+}
+
+// downstreamMeta returns a copy of a caller's request _meta without
+// connectionMetaKeys, for forwarding downstream. Every other field, such as
+// progressToken, passes through, and the caller's _meta is left unchanged.
+func downstreamMeta(meta *mcp.Meta) *mcp.Meta {
+	if meta == nil {
+		return nil
+	}
+	stripped := *meta
+	stripped.AdditionalFields = maps.Clone(meta.AdditionalFields)
+	for _, key := range connectionMetaKeys {
+		delete(stripped.AdditionalFields, key)
+	}
+	if stripped.ProgressToken == nil && len(stripped.AdditionalFields) == 0 {
+		return nil
+	}
+	return &stripped
+}
