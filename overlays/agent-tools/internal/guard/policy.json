[
  {
    "why": "Publishing goes through the operator's signed push or `pr-loop`, never a plain push.",
    "scope": "baseline",
    "deny": ["git push origin feature/x", "git -C /tmp/r push --force-with-lease", "cd repo && git push", "true\ngit push",
      "nice -n 5 git push", "env -u HOME git push", "if true; then git push; fi", "find . -maxdepth 0 -exec git push \\;",
      "git push https://github.com/o/r HEAD"],
    "allow": ["git status", "git log --oneline -5 && git status", "grep -nE 'git\\s+push' README.md"]
  },
  {
    "why": "Repository hooks stay on.",
    "scope": "baseline",
    "deny": ["git commit --no-verify --fixup=abc"],
    "allow": ["git commit --fixup=abc", "grep -rn -e '--no-verif[y]' ."]
  },
  {
    "why": "Tags are the operator's to make; listing and verifying them is fine.",
    "scope": "baseline",
    "deny": ["git tag v1", "git tag -a v1 -m x", "git tag -d v1", "git -C r tag -s v1", "git tag -l && git tag v2"],
    "allow": ["git tag", "git tag -l", "git tag --list 'v*'", "git tag -v v1", "git tag --sort=-v:refname", "grep -nE 'git\\s+tag' x"]
  },
  {
    "why": "Merging, closing, reopening, reviewing and top-level comments are the operator's.",
    "scope": "baseline",
    "deny": ["gh pr merge 123", "gh pr comment 123 -b hi", "timeout 60 gh pr merge 1", "bash -lc 'gh pr merge 1'",
      "xargs -n 1 gh pr merge", "nix shell nixpkgs#gh -c gh pr merge 1", "gh pr review 1 --approve"],
    "allow": ["gh pr view 1", "gh pr create --draft --title t --body-file b", "grep -nE 'gh\\s+pr\\s+merge' SKILL.md"]
  },
  {
    "why": "Marking a PR ready notifies its code owners, which is the operator's call.",
    "scope": "baseline",
    "deny": ["gh pr ready 123"],
    "allow": ["gh pr ready 123 --undo"]
  },
  {
    "why": "Every PR opens as a draft.",
    "scope": "baseline",
    "deny": ["gh pr create --title t --body b", "gh pr create --fill", "gh pr create --draft=false --title t --body b",
      "gh pr create -d=false --title t"],
    "allow": ["gh pr create --draft --title t --body-file b", "gh pr create -d --title t --body b", "gh pr create --draft=true --title t --body b"]
  },
  {
    "why": "Only a PR's base, title and body may change; labels, reviewers and the rest are the operator's.",
    "scope": "baseline",
    "deny": ["gh pr edit 1 --add-label bug", "gh pr edit 1 --title t --add-reviewer u", "gh pr edit 1 -m v1"],
    "allow": ["gh pr edit 1 --title t --body-file b", "gh pr edit 1 -B main", "gh pr edit 1 --body=x"]
  },
  {
    "why": "Issues and their comments are the operator's to write.",
    "scope": "baseline",
    "deny": ["gh issue comment 1 -b x", "gh issue create -t x -b y", "gh issue close 1"],
    "allow": ["gh issue view 1", "gh issue list --state open"]
  },
  {
